# Nurho Studio - Environment Variables
# Copy this file to .env and fill in your values

# ComfyUI (for image generation)
COMFYUI_URL=http://localhost:8000

# ElevenLabs (optional - for future voiceover automation)
ELEVENLABS_API_KEY=

# YouTube (optional - for future auto-publishing)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
